# Nunca coloque credenciais reais neste arquivo versionado.
POSTGRES_IMAGE=postgres:17.6-alpine
POSTGRES_DB=account_manager
POSTGRES_USER=account_manager
BACKEND_IMAGE=docker.io/SEU_USUARIO/account-manager-backend:0.0.0
FRONTEND_IMAGE=docker.io/SEU_USUARIO/account-manager-frontend:0.0.0
APP_BASE_URL=https://contas.malyah.tech
APP_TIME_ZONE=America/Sao_Paulo

# O valor do segredo de configuração inicial fica somente em
# deploy/secrets/setup_secret.txt na VPS, nunca neste arquivo/versionamento.
# Gere um valor aleatório temporário e esvazie/rotacione o arquivo após o setup.

# Integrações reais serão configuradas apenas após P03/P04/P05.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=PLACEHOLDER
SMTP_FROM=PLACEHOLDER
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
META_WHATSAPP_TOKEN_FILE=/run/secrets/meta_whatsapp_token
GROQ_API_KEY_FILE=/run/secrets/groq_api_key
